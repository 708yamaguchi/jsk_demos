    (:init-pose (&optional (limbs '(:rarm)))
      "Predefined pose named init-pose."
      (unless (listp limbs) (setq limbs (list limbs)))
      (dolist (limb limbs)
        (case limb
          (:rarm (send self limb :angle-vector (float-vector 0.000000 0.000000 0.000000 0.000000 0.000000 0.000000)))
          (t (format t "Unknown limb is passed: ~a~%" limb))))
      (send self :angle-vector))
    (:reset-pose (&optional (limbs '(:rarm)))
      "Predefined pose named reset-pose."
      (unless (listp limbs) (setq limbs (list limbs)))
      (dolist (limb limbs)
        (case limb
          (:rarm (send self limb :angle-vector (float-vector 0.000000 -16.000000 75.000000 0.000000 -60.000000 0.000000)))
          (t (format t "Unknown limb is passed: ~a~%" limb))))
      (send self :angle-vector))
